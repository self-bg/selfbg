# rembg model to load. Options include:
#   birefnet-general       (default, near-SOTA quality, general subjects)
#   birefnet-general-lite  (faster, lower memory)
#   birefnet-portrait      (people)
#   u2net                  (classic, small, fast)
#   isnet-general-use      (good on complex edges)
# Full list: https://github.com/danielgatis/rembg#models
SELFBG_MODEL=birefnet-general

# Max upload size in MB (enforced at ingress; oversize requests get 413).
SELFBG_MAX_UPLOAD_MB=25

# CORS: which origins the web UI is served from. Comma-separated.
# Defaults to the docker-compose web service on the same host.
SELFBG_CORS_ORIGINS=http://localhost:3000

# Redis connection URL. Points at the redis service defined in docker-compose
# by default. Only change this if you're running Redis externally.
SELFBG_REDIS_URL=redis://redis:6379/0

# How long finished / failed jobs and their result files stay accessible
# before being cleaned up. Default is 24 hours.
SELFBG_RESULT_TTL_SECONDS=86400

# How often the cleaner container scans and deletes expired job folders
# from disk. Defaults to hourly. Too low wastes CPU; too high delays cleanup.
SELFBG_CLEANUP_INTERVAL_SECONDS=3600

# ---- Video processing (CPU) ----

# Max size of a video upload in MB. Default 200 MB, which is roughly a
# 30-second phone clip.
SELFBG_MAX_VIDEO_UPLOAD_MB=200

# Hard cap on video length. Anything longer is rejected by the worker.
# CPU video matting is slow — start low and raise only if your box can
# keep up. 30 seconds is a comfortable default on modern CPUs.
SELFBG_MAX_VIDEO_DURATION_SECONDS=30

# The worker downscales the video so the shorter side fits this many
# pixels, preserving aspect ratio. Default 480 (roughly 480p). Raise if
# you have a fast CPU and want higher resolution output.
SELFBG_MAX_VIDEO_SHORT_SIDE_PX=480

# Image tag to run. Defaults to :latest. Pin to a release once you've deployed
# so an upstream regression doesn't break your instance on the next docker
# compose pull.
#   SELFBG_TAG=v0.1.0
SELFBG_TAG=latest

# Port bindings. 0.0.0.0 listens on every network interface of the host, so
# other devices on your LAN (and your reverse proxy) can reach the service.
# Set to 127.0.0.1 to restrict it to the host only — useful when a reverse
# proxy runs on the same box and you don't want the raw ports exposed to
# the LAN. There is no built-in auth — if you expose selfbg beyond your
# LAN, put an auth layer (reverse-proxy basic auth, Authelia, Tailscale,
# etc.) in front of it.
API_BIND=0.0.0.0:8000
WEB_BIND=0.0.0.0:3000
