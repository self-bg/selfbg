# REQUIRED. Every processing endpoint requires the client to send:
#   X-API-Key: <this value>
# Must be at least 16 characters. Generate a strong one with:
#   openssl rand -hex 32
# The server refuses to start if this is missing.
SELFBG_API_KEY=

# rembg model to load. Options include:
#   birefnet-general       (default, near-SOTA quality, general subjects)
#   birefnet-general-lite  (faster, lower memory)
#   birefnet-portrait      (people)
#   u2net                  (classic, small, fast)
#   isnet-general-use      (good on complex edges)
# Full list: https://github.com/danielgatis/rembg#models
SELFBG_MODEL=birefnet-general

# Max upload size in MB (enforced at ingress; oversize requests get 413).
SELFBG_MAX_UPLOAD_MB=25

# CORS: which origins the web UI is served from. Comma-separated.
# Defaults to the docker-compose web service on the same host.
SELFBG_CORS_ORIGINS=http://localhost:3000

# Image tag to run. Defaults to :latest. Pin to a release once you've deployed
# so an upstream regression doesn't break your instance on the next docker
# compose pull.
#   SELFBG_TAG=v0.1.0
SELFBG_TAG=latest

# Port bindings. 0.0.0.0 listens on every network interface of the host, so
# other devices on your LAN (and your reverse proxy) can reach the service.
# Set to 127.0.0.1 to restrict it to the host only — useful when a reverse
# proxy runs on the same box and you don't want the raw ports exposed to
# the LAN. The API key is mandatory regardless of where the port is bound,
# so accidental exposure never leaks anything.
API_BIND=0.0.0.0:8000
WEB_BIND=0.0.0.0:3000
